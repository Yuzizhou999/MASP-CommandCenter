APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8877
MASP_ENGINE_ROOT=E:\project\MASP
MASP_ALLOW_DIRTY_DEVELOPMENT=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_CIRCUIT_FAILURE_THRESHOLD=3
DEEPSEEK_CIRCUIT_RESET_SECONDS=30
DEEPSEEK_INPUT_COST_PER_MILLION=0.27
DEEPSEEK_OUTPUT_COST_PER_MILLION=1.10
LLM_PROVIDER=deepseek
LOCAL_LLM_ENABLED=false
LOCAL_LLM_API_KEY=local
LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_LLM_MODEL=masp-intent-lora
LOCAL_LLM_TIMEOUT_SECONDS=30
LOCAL_LLM_MODEL_CARD=models/masp-intent-lora/model-card.json
MASP_AGENT_MODEL_ID=masp-ppo-priority
MASP_AGENT_MODEL_VERSION=unconfigured
MASP_AGENT_CHECKPOINT=
MASP_AGENT_DEVICE=cpu

