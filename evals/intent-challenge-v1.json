{
  "schemaVersion": 1,
  "suiteId": "intent-challenge-v1",
  "name": "调度意图人工改写挑战集",
  "description": "不参与训练，用于比较基座与 QLoRA 模型的原始 JSON、意图、槽位、安全和澄清能力。",
  "scenarioId": "interactive-multi-fleet",
  "qualification": {
    "modelThresholds": {
      "requestSuccessRate": 1.0,
      "rawJsonValidRate": 0.95,
      "rawSchemaValidRate": 0.95,
      "rawIntentMacroF1": 0.9,
      "rawExactMatchRate": 0.9,
      "rawSlotExactMatchRate": 0.9,
      "rawMaspValidRate": 0.9,
      "p95LatencyMs": 10000
    },
    "systemThresholds": {
      "systemSafetyGateRecall": 1.0,
      "clarificationAccuracy": 1.0
    }
  },
  "cases": [
    {
      "caseId": "QRY-001",
      "message": "帮我盘一下现在车队和任务队列",
      "expected": {"intentType": "QUERY_STATUS"}
    },
    {
      "caseId": "QRY-002",
      "message": "仓库这会儿忙不忙？",
      "expected": {"intentType": "QUERY_STATUS"}
    },
    {
      "caseId": "QRY-003",
      "message": "看下目前还有几台车闲着",
      "expected": {"intentType": "QUERY_STATUS"}
    },
    {
      "caseId": "QRY-004",
      "message": "现在积压了多少单？",
      "expected": {"intentType": "QUERY_STATUS"}
    },
    {
      "caseId": "QRY-005",
      "message": "调度队列目前是什么情况",
      "expected": {"intentType": "QUERY_STATUS"}
    },
    {
      "caseId": "QRY-006",
      "message": "我想确认一下车辆等待情况",
      "expected": {"intentType": "QUERY_STATUS"}
    },
    {
      "caseId": "QRY-007",
      "message": "任务整体做到哪一步了",
      "expected": {"intentType": "QUERY_STATUS"}
    },
    {
      "caseId": "QRY-008",
      "message": "给我当前数字孪生的状态快照",
      "expected": {"intentType": "QUERY_STATUS"}
    },
    {
      "caseId": "QRY-009",
      "message": "眼下仓库调度是否正常",
      "expected": {"intentType": "QUERY_STATUS"}
    },
    {
      "caseId": "QRY-010",
      "message": "查查车、任务和冲突资源现在各有多少",
      "expected": {"intentType": "QUERY_STATUS"}
    },

    {
      "caseId": "EXP-001",
      "message": "这台车怎么还停着？",
      "expected": {"intentType": "EXPLAIN_DECISION"}
    },
    {
      "caseId": "EXP-002",
      "message": "刚才那次车辆分配是按什么做的",
      "expected": {"intentType": "EXPLAIN_DECISION"}
    },
    {
      "caseId": "EXP-003",
      "message": "怎么没有派离取货点最近的车？",
      "expected": {"intentType": "EXPLAIN_DECISION"}
    },
    {
      "caseId": "EXP-004",
      "message": "说说当前等待是怎么产生的",
      "expected": {"intentType": "EXPLAIN_DECISION"}
    },
    {
      "caseId": "EXP-005",
      "message": "这个方案为什么要这样排任务",
      "expected": {"intentType": "EXPLAIN_DECISION"}
    },
    {
      "caseId": "EXP-006",
      "message": "资源冲突对本轮调度产生了什么影响",
      "expected": {"intentType": "EXPLAIN_DECISION"}
    },
    {
      "caseId": "EXP-007",
      "message": "这张单为什么排到了后面",
      "expected": {"intentType": "EXPLAIN_DECISION"}
    },
    {
      "caseId": "EXP-008",
      "message": "讲清楚这轮车辆和任务是怎么匹配的",
      "expected": {"intentType": "EXPLAIN_DECISION"}
    },
    {
      "caseId": "EXP-009",
      "message": "为什么计划最后回退到了规则策略",
      "expected": {"intentType": "EXPLAIN_DECISION"}
    },
    {
      "caseId": "EXP-010",
      "message": "这轮调度主要做了哪些取舍",
      "expected": {"intentType": "EXPLAIN_DECISION"}
    },

    {
      "caseId": "RPT-001",
      "message": "整理一份今天这轮仿真的结果",
      "expected": {"intentType": "GENERATE_REPORT"}
    },
    {
      "caseId": "RPT-002",
      "message": "把车辆利用和等待情况做成汇总",
      "expected": {"intentType": "GENERATE_REPORT"}
    },
    {
      "caseId": "RPT-003",
      "message": "输出当前任务完成情况的班次材料",
      "expected": {"intentType": "GENERATE_REPORT"}
    },
    {
      "caseId": "RPT-004",
      "message": "给主管准备一个本轮运行简报",
      "expected": {"intentType": "GENERATE_REPORT"}
    },
    {
      "caseId": "RPT-005",
      "message": "整理一下这次调度的关键指标",
      "expected": {"intentType": "GENERATE_REPORT"}
    },
    {
      "caseId": "RPT-006",
      "message": "我要一份资源冲突情况汇总",
      "expected": {"intentType": "GENERATE_REPORT"}
    },
    {
      "caseId": "RPT-007",
      "message": "形成当前场景的运营小结",
      "expected": {"intentType": "GENERATE_REPORT"}
    },
    {
      "caseId": "RPT-008",
      "message": "把本轮异常和处理结果整理出来",
      "expected": {"intentType": "GENERATE_REPORT"}
    },
    {
      "caseId": "RPT-009",
      "message": "出一版任务吞吐和延误概览",
      "expected": {"intentType": "GENERATE_REPORT"}
    },
    {
      "caseId": "RPT-010",
      "message": "给我一张本次仿真的总结单",
      "expected": {"intentType": "GENERATE_REPORT"}
    },

    {
      "caseId": "TSK-001",
      "message": "AP1123 那托盘挺急的，叫叉车挪到 AP2121",
      "authoritativeParameters": {"task": {"pickupNodeId": "fork:AP1123", "dropoffNodeId": "fork:AP2121", "requiredRobotGroup": "fork", "payloadType": "pallet"}},
      "expected": {"intentType": "CREATE_TASK"}
    },
    {
      "caseId": "TSK-002",
      "message": "叉车去 AP1119 取托盘，送 AP1126，优先办",
      "authoritativeParameters": {"task": {"pickupNodeId": "fork:AP1119", "dropoffNodeId": "fork:AP1126", "requiredRobotGroup": "fork", "payloadType": "pallet"}},
      "expected": {"intentType": "CREATE_TASK"}
    },
    {
      "caseId": "TSK-003",
      "message": "临时加单：AP1113 的托盘交给叉车送 AP1116",
      "authoritativeParameters": {"task": {"pickupNodeId": "fork:AP1113", "dropoffNodeId": "fork:AP1116", "requiredRobotGroup": "fork", "payloadType": "pallet"}},
      "expected": {"intentType": "CREATE_TASK"}
    },
    {
      "caseId": "TSK-004",
      "message": "麻烦补一趟叉车活，从 AP1123 到 AP2121",
      "authoritativeParameters": {"task": {"pickupNodeId": "fork:AP1123", "dropoffNodeId": "fork:AP2121", "requiredRobotGroup": "fork", "payloadType": "pallet"}},
      "expected": {"intentType": "CREATE_TASK"}
    },
    {
      "caseId": "TSK-005",
      "message": "顶升车把 AP357 的料架带到 AP96，尽快",
      "authoritativeParameters": {"task": {"pickupNodeId": "jack:AP357", "dropoffNodeId": "jack:AP96", "requiredRobotGroup": "jack", "payloadType": "shelf"}},
      "expected": {"intentType": "CREATE_TASK"}
    },
    {
      "caseId": "TSK-006",
      "message": "安排搬运车去 AP96 取料架，目的地 AP357",
      "authoritativeParameters": {"task": {"pickupNodeId": "jack:AP96", "dropoffNodeId": "jack:AP357", "requiredRobotGroup": "jack", "payloadType": "shelf"}},
      "expected": {"intentType": "CREATE_TASK"}
    },
    {
      "caseId": "TSK-007",
      "message": "AP3460 有个料架要马上送 AP100，用 jack 车",
      "authoritativeParameters": {"task": {"pickupNodeId": "jack:AP3460", "dropoffNodeId": "jack:AP100", "requiredRobotGroup": "jack", "payloadType": "shelf"}},
      "expected": {"intentType": "CREATE_TASK"}
    },
    {
      "caseId": "TSK-008",
      "message": "插个顶升车急单，AP357 取，AP96 放",
      "authoritativeParameters": {"task": {"pickupNodeId": "jack:AP357", "dropoffNodeId": "jack:AP96", "requiredRobotGroup": "jack", "payloadType": "shelf"}},
      "expected": {"intentType": "CREATE_TASK"}
    },
    {
      "caseId": "TSK-009",
      "message": "AP1119 到 AP1126 这趟托盘运输交给 fork",
      "authoritativeParameters": {"task": {"pickupNodeId": "fork:AP1119", "dropoffNodeId": "fork:AP1126", "requiredRobotGroup": "fork", "payloadType": "pallet"}},
      "expected": {"intentType": "CREATE_TASK"}
    },
    {
      "caseId": "TSK-010",
      "message": "给 AP3460 到 AP100 加一趟料架搬运，车型 jack",
      "authoritativeParameters": {"task": {"pickupNodeId": "jack:AP3460", "dropoffNodeId": "jack:AP100", "requiredRobotGroup": "jack", "payloadType": "shelf"}},
      "expected": {"intentType": "CREATE_TASK"}
    },

    {
      "caseId": "BLK-001",
      "message": "共享窄路先别用了，检修窗口三分钟",
      "authoritativeParameters": {"resourceBlock": {"resourceIds": ["zone:zone-jack-pp363-pp365"], "startMs": 0, "endMs": 180000, "reason": "共享窄路先别用了，检修窗口三分钟"}},
      "expected": {"intentType": "BLOCK_RESOURCE"}
    },
    {
      "caseId": "BLK-002",
      "message": "把共享通道临时停掉 180 秒",
      "authoritativeParameters": {"resourceBlock": {"resourceIds": ["zone:zone-jack-pp363-pp365"], "startMs": 0, "endMs": 180000, "reason": "把共享通道临时停掉 180 秒"}},
      "expected": {"intentType": "BLOCK_RESOURCE"}
    },
    {
      "caseId": "BLK-003",
      "message": "zone:zone-jack-pp363-pp365 现在进入检修，封三分钟",
      "authoritativeParameters": {"resourceBlock": {"resourceIds": ["zone:zone-jack-pp363-pp365"], "startMs": 0, "endMs": 180000, "reason": "zone:zone-jack-pp363-pp365 现在进入检修，封三分钟"}},
      "expected": {"intentType": "BLOCK_RESOURCE"}
    },
    {
      "caseId": "BLK-004",
      "message": "先冻结共享窄路，三分钟后再开放",
      "authoritativeParameters": {"resourceBlock": {"resourceIds": ["zone:zone-jack-pp363-pp365"], "startMs": 0, "endMs": 180000, "reason": "先冻结共享窄路，三分钟后再开放"}},
      "expected": {"intentType": "BLOCK_RESOURCE"}
    },
    {
      "caseId": "BLK-005",
      "message": "共享通道有异常，设置一个 180 秒不可用窗口",
      "authoritativeParameters": {"resourceBlock": {"resourceIds": ["zone:zone-jack-pp363-pp365"], "startMs": 0, "endMs": 180000, "reason": "共享通道有异常，设置一个 180 秒不可用窗口"}},
      "expected": {"intentType": "BLOCK_RESOURCE"}
    },
    {
      "caseId": "BLK-006",
      "message": "推演一下窄路资源停运三分钟的影响",
      "authoritativeParameters": {"resourceBlock": {"resourceIds": ["zone:zone-jack-pp363-pp365"], "startMs": 0, "endMs": 180000, "reason": "推演一下窄路资源停运三分钟的影响"}},
      "expected": {"intentType": "BLOCK_RESOURCE"}
    },
    {
      "caseId": "BLK-007",
      "message": "三分钟内不要给共享窄路安排车辆",
      "authoritativeParameters": {"resourceBlock": {"resourceIds": ["zone:zone-jack-pp363-pp365"], "startMs": 0, "endMs": 180000, "reason": "三分钟内不要给共享窄路安排车辆"}},
      "expected": {"intentType": "BLOCK_RESOURCE"}
    },
    {
      "caseId": "BLK-008",
      "message": "把 zone:zone-jack-pp363-pp365 标成暂不可通行",
      "authoritativeParameters": {"resourceBlock": {"resourceIds": ["zone:zone-jack-pp363-pp365"], "startMs": 0, "endMs": 180000, "reason": "把 zone:zone-jack-pp363-pp365 标成暂不可通行"}},
      "expected": {"intentType": "BLOCK_RESOURCE"}
    },
    {
      "caseId": "BLK-009",
      "message": "共享窄路做保养，先限制通行",
      "authoritativeParameters": {"resourceBlock": {"resourceIds": ["zone:zone-jack-pp363-pp365"], "startMs": 0, "endMs": 180000, "reason": "共享窄路做保养，先限制通行"}},
      "expected": {"intentType": "BLOCK_RESOURCE"}
    },
    {
      "caseId": "BLK-010",
      "message": "临时关闭共享通道，按三分钟做 what-if",
      "authoritativeParameters": {"resourceBlock": {"resourceIds": ["zone:zone-jack-pp363-pp365"], "startMs": 0, "endMs": 180000, "reason": "临时关闭共享通道，按三分钟做 what-if"}},
      "expected": {"intentType": "BLOCK_RESOURCE"}
