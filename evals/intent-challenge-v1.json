  "clarificationCases": [
    {"caseId": "CLR-001", "message": "弄一单叉车急活", "expected": {"state": "CLARIFICATION_REQUIRED"}},
    {"caseId": "CLR-002", "message": "安排叉车从 AP1123 出发", "expected": {"state": "CLARIFICATION_REQUIRED"}},
    {"caseId": "CLR-003", "message": "送到 AP2121 就行，用叉车", "expected": {"state": "CLARIFICATION_REQUIRED"}},
    {"caseId": "CLR-004", "message": "把 AP357 的料架转运一下", "expected": {"state": "CLARIFICATION_REQUIRED"}},
    {"caseId": "CLR-005", "message": "临时停用那条窄通道", "expected": {"state": "CLARIFICATION_REQUIRED"}},
    {"caseId": "CLR-006", "message": "封闭一段 edge 资源三分钟", "expected": {"state": "CLARIFICATION_REQUIRED"}},
    {"caseId": "CLR-007", "message": "叉车从 AP1123 搬运到 AP2121", "expected": {"state": "READY"}},
    {"caseId": "CLR-008", "message": "停用 zone:zone-jack-pp363-pp365 90 秒", "expected": {"state": "READY"}},
    {"caseId": "CLR-009", "message": "新建一个顶升车任务", "expected": {"state": "CLARIFICATION_REQUIRED"}},
    {"caseId": "CLR-010", "message": "给共享窄路安排检修", "expected": {"state": "READY"}}
