{
  "schemaVersion": 1,
  "suiteId": "agent-trajectories-v1",
  "name": "仓储调度 Agent 冻结轨迹评测",
  "goldSource": "manual-independent-annotation",
  "description": "评测标签由人工业务规则冻结，不来自 teacher、候选模型或确定性 rollout 输出。",
